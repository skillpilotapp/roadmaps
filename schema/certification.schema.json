{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skillpilotapp/roadmaps/schema/certification.schema.json",
  "title": "SkillPilot certification guide",
  "type": "object",
  "required": ["slug", "title", "provider", "description", "updatedAt", "overview", "exam", "domains", "prepPath"],
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sourcedValue": {
      "description": "A quantitative claim that may not be stated without saying where it came from and when it was read.",
      "type": "object",
      "required": ["value", "source", "retrievedAt"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 3 },
        "retrievedAt": { "$ref": "#/$defs/isoDate" }
      }
    },
    "resource": {
      "type": "object",
      "required": ["title", "type", "free"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["documentation", "course", "tutorial", "certification", "book", "video"] },
        "url": { "type": "string", "format": "uri" },
        "provider": { "type": "string", "minLength": 1 },
        "free": { "type": "boolean" },
        "year": { "type": "integer" },
        "isbnAsin": { "type": "string" },
        "freeAlternative": {
          "type": "object",
          "required": ["title", "url"],
          "additionalProperties": false,
          "properties": { "title": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
        }
      }
    }
  },
  "properties": {
    "slug": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 3, "maxLength": 100 },
    "provider": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 40, "maxLength": 300 },
    "updatedAt": { "$ref": "#/$defs/isoDate" },
    "overview": { "type": "string", "minLength": 100 },
    "exam": {
      "type": "object",
      "required": ["code", "cost", "duration", "passingScore", "validity", "format"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 2 },
        "cost": { "$ref": "#/$defs/sourcedValue" },
        "duration": { "type": "string", "minLength": 1 },
        "passingScore": { "type": "string", "minLength": 1 },
        "validity": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 }
      }
    },
    "domains": {
      "description": "The published exam blueprint. Weights must sum to 100 — checked by validate.mjs, since JSON Schema cannot express it.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "weight", "topics"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 3 },
          "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
          "topics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
        }
      }
    },
    "prepPath": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["step", "description", "estimatedHours"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "string", "minLength": 5 },
          "description": { "type": "string", "minLength": 40, "maxLength": 400 },
          "estimatedHours": { "type": "integer", "exclusiveMinimum": 0 },
          "resources": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/resource" } }
        }
      }
    },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "relatedRoadmaps": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "additionalProperties": false,
        "properties": { "question": { "type": "string", "minLength": 10 }, "answer": { "type": "string", "minLength": 40 } }
      }
    }
  }
}
