{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skillpilotapp/roadmaps/schema/roadmap.schema.json",
  "title": "SkillPilot career roadmap",
  "type": "object",
  "required": [
    "slug", "title", "description", "level", "updatedAt", "overview",
    "totalDuration", "salary", "prerequisites", "phases"
  ],
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sourcedValue": {
      "description": "A quantitative claim that may not be stated without saying where it came from and when it was read.",
      "type": "object",
      "required": ["value", "source", "retrievedAt"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 3 },
        "retrievedAt": { "$ref": "#/$defs/isoDate" }
      }
    },
    "resource": {
      "type": "object",
      "required": ["title", "type", "free"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["documentation", "course", "tutorial", "certification", "book", "video"]
        },
        "url": { "type": "string", "format": "uri" },
        "provider": { "type": "string", "minLength": 1 },
        "free": { "type": "boolean" },
        "year": { "type": "integer" },
        "isbnAsin": { "type": "string" },
        "freeAlternative": {
          "description": "Required by editorial policy whenever a paid book is the only route to a topic.",
          "type": "object",
          "required": ["title", "url"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "required": ["name", "level", "category"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "level": { "enum": ["beginner", "intermediate", "advanced"] },
        "category": { "enum": ["core", "tool", "certification"] }
      }
    },
    "phase": {
      "type": "object",
      "required": ["id", "title", "description", "duration", "skills", "projects"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 3, "maxLength": 80 },
        "description": { "type": "string", "minLength": 120, "maxLength": 500 },
        "duration": { "type": "string", "minLength": 1 },
        "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 5 } },
        "skills": { "type": "array", "minItems": 3, "maxItems": 10, "items": { "$ref": "#/$defs/skill" } },
        "projects": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 20 } },
        "resources": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/resource" } }
      }
    }
  },
  "properties": {
    "slug": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "description": { "type": "string", "minLength": 40, "maxLength": 300 },
    "level": { "enum": ["beginner", "intermediate", "advanced"] },
    "updatedAt": { "$ref": "#/$defs/isoDate" },
    "overview": { "type": "string", "minLength": 100 },
    "totalDuration": { "$ref": "#/$defs/sourcedValue" },
    "salary": {
      "type": "object",
      "required": ["currency", "market", "entry", "mid", "senior"],
      "additionalProperties": false,
      "properties": {
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "market": { "type": "string", "minLength": 2 },
        "entry": { "$ref": "#/$defs/sourcedValue" },
        "mid": { "$ref": "#/$defs/sourcedValue" },
        "senior": { "$ref": "#/$defs/sourcedValue" }
      }
    },
    "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 5 } },
    "stages": {
      "description": "Coarse groupings over the phase list, for rendering. `from`/`to` are phase indices, half-open.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 3 },
          "from": { "type": "integer", "minimum": 0 },
          "to": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "phases": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/phase" } },
    "jobReality": {
      "description": "Optional, and present on 2 of the 11 paths so far. Editorial, not sourced. Claims that would need a citation (openings, remote share, demand) are deliberately not modelled here.",
      "type": "object",
      "required": ["dayToDay", "interview", "entryPaths", "progression", "failureModes"],
      "additionalProperties": false,
      "properties": {
        "dayToDay": { "type": "string", "minLength": 200, "maxLength": 900 },
        "interview": { "type": "string", "minLength": 200, "maxLength": 900 },
        "entryPaths": { "type": "string", "minLength": 200, "maxLength": 900 },
        "progression": { "type": "string", "minLength": 200, "maxLength": 900 },
        "failureModes": { "type": "string", "minLength": 200, "maxLength": 900 }
      }
    },
    "relatedRoadmaps": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
    "relatedCertifications": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string", "minLength": 10 },
          "answer": { "type": "string", "minLength": 40 }
        }
      }
    }
  }
}
